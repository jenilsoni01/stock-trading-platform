# ============================================
# Stock Trading Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env or .env.local to Git.
# ============================================

# === Deployment Mode ===
# Options: local-compose, multi-pc, kubernetes
DEPLOY_MODE=local-compose

# === Central Infrastructure Host ===
# For local-compose mode, use "localhost"
# For multi-pc mode, use the central host's LAN IP (e.g., 192.168.1.100)
# Run 'ipconfig' on Windows or 'ipconfig getifaddr en0' on macOS to find it
INFRA_HOST=localhost

# === PostgreSQL (Identity & Wallet Service) ===
POSTGRES_HOST=${INFRA_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=identity_wallet_db
POSTGRES_USER=iw_service
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# === MongoDB (Market Data Service) ===
MONGODB_HOST=${INFRA_HOST}
MONGODB_PORT=27017
MONGODB_DATABASE=market_data_db
MONGODB_USER=md_service
MONGODB_PASSWORD=CHANGE_ME_mongo_password

# === MySQL (Order Service) ===
MYSQL_HOST=${INFRA_HOST}
MYSQL_PORT=3306
MYSQL_DATABASE=order_service_db
MYSQL_USER=order_service
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# === Redis (Portfolio Service) ===
REDIS_HOST=${INFRA_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=${INFRA_HOST}:9092
# Internal listener for Docker-to-Docker communication
KAFKA_INTERNAL_LISTENER=kafka:29092
# External listener for host/LAN access
KAFKA_EXTERNAL_LISTENER=${INFRA_HOST}:9092

# === Service Discovery (Eureka) ===
EUREKA_URL=http://${INFRA_HOST}:8761/eureka

# === API Gateway ===
GATEWAY_HOST=${INFRA_HOST}
GATEWAY_PORT=8080
GATEWAY_BASE_URL=http://${INFRA_HOST}:8080

# === Service Ports ===
IDENTITY_SERVICE_PORT=8081
MARKET_SERVICE_PORT=8082
MARKET_SERVICE_GRPC_PORT=50051
ORDER_SERVICE_PORT=8083
PORTFOLIO_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# === Service URLs (for inter-service communication) ===
# In Docker Compose: use service names (e.g., identity-wallet-service:8081)
# On host / multi-pc: use IP:port
IDENTITY_SERVICE_URL=http://${INFRA_HOST}:8081
MARKET_SERVICE_URL=http://${INFRA_HOST}:8082
MARKET_SERVICE_GRPC_URL=${INFRA_HOST}:50051
ORDER_SERVICE_URL=http://${INFRA_HOST}:8083
PORTFOLIO_SERVICE_URL=http://${INFRA_HOST}:8084
NOTIFICATION_SERVICE_URL=http://${INFRA_HOST}:8085

# === JWT ===
JWT_SECRET=CHANGE_ME_use_a_secure_random_string_at_least_256_bits
JWT_ISSUER=stock-trading-platform
JWT_EXPIRATION_MS=3600000

# === Observability ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
LOKI_PORT=3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://${INFRA_HOST}:4317

# === Frontend ===
WEB_CLIENT_PORT=3001
PUBLIC_BASE_URL=http://${INFRA_HOST}:8080
