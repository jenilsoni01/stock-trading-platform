# ==============================================================================
# Stock Trading Platform - Multi-PC Distributed LAN Configuration Template
# ==============================================================================
# Copy this file to '.env' on each of the 5 machines and replace the IP addresses
# with the actual local Wi-Fi / Ethernet LAN IP addresses (e.g. from 'ipconfig' or 'ifconfig').
# ==============================================================================

# --- LAN IP Addresses of the 5 Machines ---
# PC1 (Lead / Jenil - Windows): Runs Gateway, Eureka, Identity & Wallet, Web Client, Kafka, Postgres
PC1_IP=192.168.1.101

# PC2 (Jeel - macOS): Runs Market Data Service (Go / Gin) + MongoDB
PC2_IP=192.168.1.102

# PC3 (Harsh - Windows): Runs Order Service (C++ / Drogon) + MySQL
PC3_IP=192.168.1.103

# PC4 (Kevl - macOS): Runs Portfolio Service (Python / FastAPI) + Redis
PC4_IP=192.168.1.104

# PC5 (Krish - Windows): Runs Notification Service (Node.js / Express) + Firestore
PC5_IP=192.168.1.105

# --- Shared JWT Secret (must match across all 5 machines) ---
JWT_SECRET=dev-jwt-secret-change-me-in-production-this-must-be-at-least-256-bits-long-for-hs256
